# This file is an example only. The Python gateway and Vite do not load it
# automatically: export it in a development shell, or create environment files
# for those processes. Never commit a populated .env file.

# Browser build-time settings. Use the local gateway for development and an
# HTTPS same-origin gateway for a public deployment.
VITE_WALLET_GATEWAY_URL=https://app.tscweb.xyz/wallet
VITE_ALLOWED_GATEWAY_ORIGINS=
VITE_MARKET_DATA_URL=https://app.tscweb.xyz/market/v1
VITE_SAFETRADE_TICKER_URL=https://safe.trade/api/v2/trade/public/tickers/tscusdt
VITE_CURRENCY_RATES_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json
VITE_SOURCE_URL=https://github.com/rHuhui/TensorCashWebWallet
VITE_EXPLORER_URL=https://explorer.example

# Gateway runtime settings. The service and Core RPC must remain on loopback.
TSCWALLET_HOST=127.0.0.1
TSCWALLET_PORT=9920
TSCWALLET_INDEX_DB=./data/explorer.sqlite3
TSCWALLET_RPC_URL=http://127.0.0.1:8332
TSCWALLET_RPC_USER=replace-with-dedicated-rpc-user
TSCWALLET_RPC_PASSWORD=replace-with-a-long-random-secret

# Development origin. A production operator should set this to the exact HTTPS
# wallet origin(s) in a server-only environment file.
TSCWALLET_ALLOWED_ORIGINS=http://127.0.0.1:5173
TSCWALLET_RPC_TIMEOUT=8
TSCWALLET_PUBLIC_RPC_TIMEOUT=2
TSCWALLET_CHAIN_STATUS_CACHE_SECONDS=5
TSCWALLET_RPC_FAILURE_BACKOFF_SECONDS=5
TSCWALLET_RPC_BATCH_SIZE=50
TSCWALLET_UTXO_CANDIDATE_LIMIT=500
# 0 indexes the complete mempool so older pending wallet transactions remain visible.
TSCWALLET_MEMPOOL_LIMIT=0
TSCWALLET_PUBLIC_READ_RATE=2
TSCWALLET_PUBLIC_READ_BURST=12
TSCWALLET_MAX_PAGE=10000
