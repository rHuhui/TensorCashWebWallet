# Install as /etc/tscwallet.env with owner root and mode 0600.
# Never place this file in the web root or commit real credentials.
TSCWALLET_INDEX_DB=/srv/tensorcash/explorer.sqlite3
TSCWALLET_RPC_URL=http://127.0.0.1:39240
TSCWALLET_RPC_USER=replace-with-dedicated-rpc-user
TSCWALLET_RPC_PASSWORD=replace-with-a-long-random-secret
TSCWALLET_ALLOWED_ORIGINS=https://app.example.org
TSCWALLET_RPC_TIMEOUT=8
TSCWALLET_PUBLIC_RPC_TIMEOUT=2
TSCWALLET_CHAIN_STATUS_CACHE_SECONDS=5
TSCWALLET_RPC_FAILURE_BACKOFF_SECONDS=5
TSCWALLET_RPC_BATCH_SIZE=50
TSCWALLET_UTXO_CANDIDATE_LIMIT=500
# 0 indexes the complete mempool so older pending wallet transactions remain visible.
TSCWALLET_MEMPOOL_LIMIT=0
TSCWALLET_PUBLIC_READ_RATE=2
TSCWALLET_PUBLIC_READ_BURST=12
TSCWALLET_OVERVIEW_READ_RATE=50
TSCWALLET_OVERVIEW_READ_BURST=200
TSCWALLET_QUERY_CACHE_SECONDS=2
TSCWALLET_QUERY_CACHE_ENTRIES=4096
TSCWALLET_MEMPOOL_BACKGROUND_REFRESH=1
TSCWALLET_MEMPOOL_REFRESH_SECONDS=10
TSCWALLET_MAX_PAGE=10000
