[Unit]
Description=TensorCash Stateless Web Wallet Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tscwallet
Group=tscwallet
EnvironmentFile=/etc/tscwallet.env
WorkingDirectory=/opt/tscwallet
ExecStart=/opt/tscwallet/.venv/bin/gunicorn --workers 1 --threads 32 --timeout 45 --bind 127.0.0.1:9920 server.app:create_app()
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/srv/tensorcash/explorer.sqlite3

[Install]
WantedBy=multi-user.target
